{
  "manifest_version": 3,
  "name": "Word Vocab Collector",
  "version": "1.0.0",
  "description": "Select words on any page, save them, and review Bengali meanings and AI example use cases.",
  "permissions": ["storage", "contextMenus", "sidePanel"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://text.pollinations.ai/*",
    "https://api.dictionaryapi.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Word Vocab",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
